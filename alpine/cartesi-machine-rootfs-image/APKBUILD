pkgver=0.17.1
_pkgver=$pkgver
pkgrel=1
pkgdesc="Cartesi Machine guest root filesystem image"
url="https://github.com/cartesi/machine-guest-tools"
arch="noarch"
license="GPL-2.0"
options="!check"
source="rootfs.ext2::https://github.com/cartesi/machine-guest-tools/releases/download/v${_pkgver}/rootfs-tools.ext2"
